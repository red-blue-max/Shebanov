# Timeweb (Apache behind nginx). Put next to index.html in public_html.

AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# Redirect http:// and www. to https://shebanov-swim.ru
# nginx terminates SSL in front of Apache, so %{HTTPS} is always off here:
# check X-Forwarded-Proto instead, otherwise the redirect loops forever.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://shebanov-swim.ru%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://shebanov-swim.ru%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://shebanov-swim.ru/ [L,R=301]
</IfModule>

# Hide the deploy state file of the GitHub auto-deploy
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# MIME types
AddType image/webp .webp
AddType font/woff2 .woff2
AddType video/mp4 .mp4

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache: fonts, CSS, JS, video for 1 year (URLs carry ?v=hash), images 30 days, HTML always fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css|js|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
