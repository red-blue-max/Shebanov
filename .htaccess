# Настройки для хостинга Timeweb (Apache). Лежит в корне сайта рядом с index.html.

AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# HTTPS и адрес без www: http://, www. -> https://shebanov-swim.ru
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://shebanov-swim.ru%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Типы файлов
AddType image/webp .webp
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest

# Сжатие текстовых файлов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Кэш: шрифты, CSS, JS, видео — на год (в ссылках есть версия ?v=, при обновлении она меняется),
# картинки — на 30 дней, HTML — всегда свежий.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|css|js|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
